<?xml version="1.0" encoding="utf-8"?>
<!--
  Build settings shared by every project in this tree.

  MSBuild imports this file automatically. There is nothing to reference from
  the individual project files.

  ==========================================================================
  Windows SDK version
  ==========================================================================

  If the build fails with

      The Windows SDK version 10.0.26100.0 was not found

  then your machine has a different SDK. List what you have with:

      dir "C:\Program Files (x86)\Windows Kits\10\Include"

  Then either edit the default below, or override it without touching this
  file:

      msbuild /p:WindowsTargetPlatformVersion=10.0.22621.0

  Setting WindowsTargetPlatformVersion in your environment before starting
  Visual Studio works too.

  The value has to be a full version number. The "10.0" shorthand meaning
  "latest installed SDK" is not honoured by the v141 toolset, which reports
  the SDK as missing even when one is installed.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
